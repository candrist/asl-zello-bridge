# asl-zello-bridge configuration template.
#
# Copy to bridge.env for a single instance, or one file per instance under
# instances/ when running multiple channels (see README "Multiple instances").
# Lines starting with # are comments. Do not quote values.

# ---------------------------------------------------------------------------
# Zello account (required)
# This account represents the "user" speaking from radio into Zello.
# ---------------------------------------------------------------------------
ZELLO_USERNAME=myuser
ZELLO_PASSWORD=mypass
ZELLO_CHANNEL=My Test Channel

# ---------------------------------------------------------------------------
# Zello Free (default) - requires a developer key from developers.zello.com
# ---------------------------------------------------------------------------
# Path INSIDE the container; docker-compose.yml mounts ./keys at /keys.
ZELLO_PRIVATE_KEY=/keys/zello.key
ZELLO_ISSUER=my-issuer-id
ZELLO_WS_ENDPOINT=wss://zello.io/ws

# ---------------------------------------------------------------------------
# Zello Work (alternative) - comment out the three Free variables above,
# then uncomment these two.
# ---------------------------------------------------------------------------
#ZELLO_WS_ENDPOINT=wss://zellowork.io/ws/mynetwork

# ---------------------------------------------------------------------------
# USRP / AllStarLink side
# ---------------------------------------------------------------------------
# Address the bridge listens on inside the container. Keep 0.0.0.0 in Docker;
# the published host port is controlled by USRP_PUBLISH_PORT in the compose
# command, not here.
USRP_BIND=0.0.0.0

# UDP port the bridge listens on inside the container. With the default
# compose file this can stay 34001 for every instance (containers are
# network-isolated); only the published port must be unique per instance.
USRP_RXPORT=34001

# Where USRP TX audio is sent. When Asterisk/AllStarLink runs on the Docker
# host, use host.docker.internal (mapped via extra_hosts in the compose file).
USRP_HOST=host.docker.internal

# UDP port Asterisk receives audio on. 32001 is the ASL default for
# rxchannel = USRP/<host>:34001:32001.
USRP_TXPORT=32001

# ---------------------------------------------------------------------------
# Optional audio and logging settings
# ---------------------------------------------------------------------------
USRP_GAIN_RX_DB=0
USRP_GAIN_TX_DB=0
OPUS_COMPLEXITY=5
#OPUS_BITRATE=24000
LOG_LEVEL=INFO
#LOG_FORMAT=%(levelname)s:%(name)s:%(message)s
