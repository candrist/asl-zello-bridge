# asl-zello-bridge configuration template.
#
# Copy to bridge.env for a single instance, or one file per instance under
# instances/ when running multiple channels (see README "Multiple instances").
# Lines starting with # are comments. Do not quote values.

# ---------------------------------------------------------------------------
# Zello account (required)
# This account represents the "user" speaking from radio into Zello.
# ---------------------------------------------------------------------------
ZELLO_USERNAME=myuser
ZELLO_PASSWORD=mypass
ZELLO_CHANNEL=My Test Channel

# ---------------------------------------------------------------------------
# Zello Free (default) - requires a developer key from developers.zello.com
# ---------------------------------------------------------------------------
# Path INSIDE the container; docker-compose.yml mounts ./keys at /keys.
ZELLO_PRIVATE_KEY=/keys/zello.key
ZELLO_ISSUER=my-issuer-id
ZELLO_WS_ENDPOINT=wss://zello.io/ws

# ---------------------------------------------------------------------------
# Zello Work (alternative) - comment out the three Free variables above,
# then uncomment these two.
# ---------------------------------------------------------------------------
#ZELLO_WS_ENDPOINT=wss://zellowork.io/ws/mynetwork

# ---------------------------------------------------------------------------
# USRP / AllStarLink side
# ---------------------------------------------------------------------------
# The compose file runs the container with host networking, so the bridge
# uses the Docker host's own network stack directly.

# Address the bridge listens on for USRP RX audio. Keep 127.0.0.1 when
# Asterisk runs on this same machine; use 0.0.0.0 if another host must be
# able to send audio here.
USRP_BIND=127.0.0.1

# UDP port the bridge listens on. Must match the first port in your ASL
# rxchannel (e.g. USRP/127.0.0.1:34001:32001). When running multiple
# instances on one host, every instance needs a DIFFERENT value here.
USRP_RXPORT=34001

# Where USRP TX audio is sent: your Asterisk/AllStarLink host. When Asterisk
# runs on the same machine, that is simply 127.0.0.1.
USRP_HOST=127.0.0.1

# UDP port the node's USRP channel listens on locally (third part of
# rxchannel = USRP/<host>:34001:32001). Must also be unique per instance.
USRP_TXPORT=32001

# ---------------------------------------------------------------------------
# Optional audio and logging settings
# ---------------------------------------------------------------------------
USRP_GAIN_RX_DB=0
USRP_GAIN_TX_DB=0
OPUS_COMPLEXITY=5
#OPUS_BITRATE=24000
LOG_LEVEL=INFO
#LOG_FORMAT=%(levelname)s:%(name)s:%(message)s
